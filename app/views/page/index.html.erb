<% latest_by_series = @series_with_crosswords.to_h { |name, crosswords| [name, crosswords.first&.identifier] } %>
<div class="homepage">
  <div class="homepage-sidebar">
    <h3>Go to puzzle</h3>
    <form id="goto-form" data-path-prefix="<%= Rails.application.config.relative_url_root.to_s %>">
      <label for="goto-series">Series</label>
      <select id="goto-series" name="series">
        <%- Series.picker_groups.each do |group, members| -%>
          <%- if members.length > 1 -%>
            <option value="<%= group %>" data-group="<%= group %>"><%= group.titleize %></option>
          <%- else -%>
            <%- name, meta = members.first -%>
            <option value="<%= name %>" <%= tag.attributes(data: series_picker_data(name, meta, latest_by_series[name])) %>><%= Series.display_name(name) %></option>
          <%- end -%>
        <%- end -%>
      </select>

      <fieldset id="size-filter" class="radio-filter" hidden>
        <legend>Size</legend>
        <div class="radio-options">
          <%- Series.picker_groups.each do |group, members| -%>
            <%- next if members.length == 1 -%>
            <%- members.each_with_index do |(name, meta), index| -%>
              <label data-group="<%= group %>"><input type="radio" name="size" value="<%= name %>" <%= 'checked' if index.zero? %> <%= tag.attributes(data: series_picker_data(name, meta, latest_by_series[name])) %>> <%= Source.for(name).picker_label(name) %></label>
            <%- end -%>
          <%- end -%>
        </div>
      </fieldset>

      <fieldset id="day-filter" class="radio-filter" hidden>
        <legend>Day</legend>
        <div class="radio-options">
          <label><input type="radio" name="day" value="" checked> Any</label>
          <label data-day="1"><input type="radio" name="day" value="1"> Mon</label>
          <label data-day="2"><input type="radio" name="day" value="2"> Tue</label>
          <label data-day="3"><input type="radio" name="day" value="3"> Wed</label>
          <label data-day="4"><input type="radio" name="day" value="4"> Thu</label>
          <label data-day="5"><input type="radio" name="day" value="5"> Fri</label>
          <label data-day="6"><input type="radio" name="day" value="6"> Sat</label>
          <label data-day="7"><input type="radio" name="day" value="7"> Sun</label>
        </div>
      </fieldset>

      <label for="goto-number">Puzzle</label>
      <div class="history-wrap">
        <input type="text" id="goto-number" name="number" autocomplete="off">
        <div id="puzzle-suggestions" class="history-list" hidden></div>
      </div>

      <label for="goto-room">Room</label>
      <div class="history-wrap">
        <input type="text" id="goto-room" name="room" placeholder="e.g. my-room" autocomplete="off">
        <div id="room-suggestions" class="history-list" hidden></div>
      </div>

      <div class="goto-buttons">
        <button type="submit">Go</button>
        <button type="button" class="random" id="random-btn">Random</button>
      </div>
      <div id="goto-error" class="form-error"></div>
      <p>
        If <strong>puzzle</strong> is empty, go to the most recent in the series.
        <br>
        If <strong>room</strong> is empty, go to a random room number.
        <br>
        Hit <strong>random</strong> to go to a random puzzle in the series.
      </p>
    </form>
  </div>

  <div class="homepage-main">
    <p class="intro">
      Pick one of the crosswords below then share the link with friends to solve together.
    </p>

    <div class="series-columns">
    <%- # `each_slice(0)` raises, so a run with nothing cached still needs a slice of 1. -%>
    <%- @series_with_crosswords.each_slice([(@series_with_crosswords.length / 2.0).ceil, 1].max) do |column_series| -%>
      <div class="series-column">
        <%- column_series.each do |series, crosswords| -%>
          <div class="series-block">
            <h3><%= Series.display_name(series) %></h3>
            <ul>
            <%- crosswords.each do |crossword| -%>
              <li class="crossword-link">
                <%= link_to(crossword.name, crossword_path(crossword.series, crossword.identifier)) %>
              </li>
            <%- end -%>
            </ul>
          </div>
        <%- end -%>
      </div>
    <%- end -%>
    </div>

    <p class="about">
      <strong>Several People are Solving</strong> is an experiment with multiplayer crosswords created by <a href="https://chriszetter.com">Chris Zetter</a>. You can <a href="https://github.com/dan-wells/multicrosser">view the code on GitHub</a>.
    </p>
  </div>
</div>
<%= javascript_include_tag "homepage" %>
