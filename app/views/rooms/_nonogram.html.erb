<h1><%= @parsed_crossword['name'] %></h1>

<%= content_tag(:div, '', class: 'js-nonogram', data: {
  crossword: @crossword,
  'crossword-identifier': crossword_identifier,
  room: params[:room],
}) %>

<%= stylesheet_link_tag "nonogram" %>
<%= javascript_include_tag "nonogram" %>

<p class="crossword-footer" style="clear: both;">
  Share this page with others to solve this nonogram with them.
  <br><%= link_to "Print this page", print_crossword_path(series: params[:series], identifier: params[:identifier]), target: "_blank" %>
</p>
