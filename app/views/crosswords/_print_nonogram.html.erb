<div class="print-page print-nonogram">
  <header class="print-header">
    <h1><%= @parsed_crossword['name'] %></h1>
  </header>

  <%= content_tag(:div, '', class: 'js-print-nonogram', data: {
    crossword: @crossword,
  }) %>
</div>

<%= stylesheet_link_tag "print_nonogram" %>
<%= javascript_include_tag "print_nonogram" %>
