<div class="print-page" data-source="<%= @source_type %>">
  <header class="print-header">
    <h1><%= @parsed_crossword['name'] %></h1>
    <%- if @parsed_crossword['subtitle'].present? -%>
      <h2 class="crossword-subtitle"><%= @parsed_crossword['subtitle'] %></h2>
    <%- end -%>
    <p class="print-meta">
      <%= Time.at(@parsed_crossword['date']/1000).to_date.strftime("%a %-d %b %Y") %>
      <%- if @parsed_crossword['creator'] -%>
        | Set by <%= @parsed_crossword['creator']['name'] %>
      <%- end -%>
    </p>
  </header>

  <%= content_tag(:div, '', class: 'js-print-crossword', data: {
    crossword: @crossword,
    source: @source_type,
  }) %>
</div>

<%= stylesheet_link_tag "print_crossword" %>
<%= javascript_include_tag "print_crossword" %>
